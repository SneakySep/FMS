# ===== Supabase (primary) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ===== Supabase (secondary) =====
SUPABASE_URL_2=https://your-second-project.supabase.co
SUPABASE_KEY_2=your-second-anon-key
SUPABASE_SERVICE_KEY_2=your-second-service-role-key

# ===== Upstash Redis =====
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===== SMTP =====
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_SENDER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

# ===== Google Gemini =====
GEMINI_API_KEY=your-gemini-api-key

# ===== MongoDB =====
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# ===== Internal logistics API =====
# Generate a long random value, for example: openssl rand -hex 32
LOGISTIC_API_KEY=replace-with-a-long-random-token
