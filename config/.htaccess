# Priority Handling Logistics / FMS — deny direct web access to config files (Apache 2.4+, e.g. XAMPP).
# Credentials and the DB bootstrap must never be reachable over HTTP.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Fallback for older Apache 2.2 installs
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>