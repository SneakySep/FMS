# ===== Application =====
APP_NAME="Freight Management System"
APP_ENV="development"
APP_URL="http://localhost:8080"

# ===== FastAPI backend =====
# Used by client-side JavaScript in the browser
PUBLIC_API_URL=http://localhost:8000

# Used by PHP server-side cURL calls
# Inside Docker Compose this is the backend service name
INTERNAL_API_URL=http://backend:8000

# ===== Optional Supabase client config =====
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ===== PHP session security =====
# Generate a long random value, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
